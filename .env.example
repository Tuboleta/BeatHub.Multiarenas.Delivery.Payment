# ==============================================================================
# BeatHub Delivery - Payment Service (.env.example - Staging Template)
# Dominio Staging: delivery-api-stg.beat-hub.com
# ==============================================================================

# Puerto y Context Path
SERVER_PORT=8083
SERVER_SERVLET_CONTEXT_PATH=/api/v1/payment

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (STAGING)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/multiarenas_beathub?currentSchema=payment,public
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Si la base de datos corre en un servidor dedicado o IP externa:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/multiarenas_beathub?currentSchema=payment,public

# ------------------------------------------------------------------------------
# CONFIGURACION JPA & FLYWAY
# ------------------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true
CORS_ALLOWED_ORIGINS=https://delivery-api-stg.beat-hub.com,https://delivery-stg.beat-hub.com,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# SEGURIDAD / JWT
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# CREDIBANCO (PASARELA DE PAGOS)
# ------------------------------------------------------------------------------
CREDIBANCO_BASE_URL=https://ecouat.credibanco.com/payment/rest
CREDIBANCO_USERNAME=TEST_USER
CREDIBANCO_PASSWORD=TEST_PASSWORD
CREDIBANCO_SECRET_KEY_HMAC=TEST_CALLBACK_KEY
CREDIBANCO_CURRENCY_CODE=170
CREDIBANCO_SESSION_TIMEOUT_SECS=1200
CREDIBANCO_DEFAULT_RETURN_URL=https://delivery-daviarena-stg.beat-hub.com/checkout/payment-return
CREDIBANCO_DEFAULT_FAIL_URL=https://delivery-daviarena-stg.beat-hub.com/checkout/payment-return?status=failed
CREDIBANCO_PUBLIC_WEBHOOK_URL=https://delivery-api-stg.beat-hub.com/api/v1/payment/webhook/credibanco/callback
CREDIBANCO_MCC_TRAVEL_AGENCY=false
CREDIBANCO_PROXY_BASE_URL=https://ecouat.credibanco.com/proxy/rest

# ------------------------------------------------------------------------------
# MERCADO PAGO (API ORDERS V1)
# ------------------------------------------------------------------------------
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=APP_USR-7403571717392222-110918-eb6ee324e2ae87c6853697468d749eaa-3831412498
MERCADOPAGO_WEBHOOK_SECRET=000353afa05c0674317e3bf3b8fb6dc4d63f2523320cd6aee0137a9326eec18f
MERCADOPAGO_CURRENCY=COP
MERCADOPAGO_DEFAULT_RETURN_URL=https://delivery-daviarena-stg.beat-hub.com/checkout/payment-return
MERCADOPAGO_DEFAULT_FAIL_URL=https://delivery-daviarena-stg.beat-hub.com/checkout/payment-return?status=failed
MERCADOPAGO_PUBLIC_WEBHOOK_URL=https://delivery-api-stg.beat-hub.com/api/v1/payment/webhook/mercadopago

# Pasarela activa por defecto: MERCADOPAGO | CREDIBANCO
PAYMENT_DEFAULT_GATEWAY=MERCADOPAGO
PAYMENT_SONDA_ENABLED=false

# ------------------------------------------------------------------------------
# MICROSERVICIOS EXTERNOS (STAGING)
# ------------------------------------------------------------------------------
# Integración con Ordering y Auth a través del DNS de Staging
SERVICES_ORDERING_URL=https://delivery-api-stg.beat-hub.com/api/v1/ordering
SERVICES_AUTH_URL=https://delivery-api-stg.beat-hub.com/api/v1/auth
