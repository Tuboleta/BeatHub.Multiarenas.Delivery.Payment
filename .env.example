# ==============================================================================
# BeatHub Delivery - Payment Service (.env.example - Staging Template)
# Dominio Staging: delivery-api-stg.beat-hub.com
# ==============================================================================

# Puerto y Context Path
SERVER_PORT=8083
SERVER_SERVLET_CONTEXT_PATH=/api/v1/payment

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (STAGING)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/multiarenas_beathub?currentSchema=payment,public
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Si la base de datos corre en un servidor dedicado o IP externa:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/multiarenas_beathub?currentSchema=payment,public

# ------------------------------------------------------------------------------
# CONFIGURACION JPA & FLYWAY
# ------------------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true
CORS_ALLOWED_ORIGINS=https://delivery-api-stg.beat-hub.com,https://delivery-stg.beat-hub.com,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# SEGURIDAD / JWT
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# CREDIBANCO (PASARELA DE PAGOS)
# ------------------------------------------------------------------------------
CREDIBANCO_BASE_URL=https://ecouat.credibanco.com/payment/rest
CREDIBANCO_USERNAME=TEST_USER
CREDIBANCO_PASSWORD=TEST_PASSWORD
CREDIBANCO_SECRET_KEY_HMAC=TEST_CALLBACK_KEY
CREDIBANCO_CURRENCY_CODE=170
CREDIBANCO_SESSION_TIMEOUT_SECS=1200
CREDIBANCO_DEFAULT_RETURN_URL=https://delivery-stg.beat-hub.com/payment/success
CREDIBANCO_DEFAULT_FAIL_URL=https://delivery-stg.beat-hub.com/payment/fail
CREDIBANCO_MCC_TRAVEL_AGENCY=false
CREDIBANCO_PROXY_BASE_URL=https://ecouat.credibanco.com/proxy/rest

# ------------------------------------------------------------------------------
# MICROSERVICIOS EXTERNOS (STAGING)
# ------------------------------------------------------------------------------
# Integración con Ordering y Auth a través del DNS de Staging
SERVICES_ORDERING_URL=https://delivery-api-stg.beat-hub.com/api/v1/ordering
SERVICES_AUTH_URL=https://delivery-api-stg.beat-hub.com/api/v1/auth
